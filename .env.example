# ============================================================================
# MISE-EN-SCÈNE — environment configuration
# Copy this file to `.env` and fill in your keys:  cp .env.example .env
# (`.env` is git-ignored; never commit real keys.)
# ============================================================================

# ── Arena.ai Image Engine (Frame Generator) ────────────────────────────────
# The image engine speaks the OpenAI-compatible Images contract:
#   POST {ARENA_API_BASE_URL}/images/generations   (image generation / edits)
#   POST {ARENA_API_BASE_URL}/chat/completions     (prompt enhancement)
#
# Live mode activates as soon as ARENA_API_KEY is set. Without a key the app
# falls back to the clearly-badged local simulation engine, so the full
# Frame Generator flow (generate → refine → variations → upscale → edit →
# save to dashboard) still works offline.
#
# NOTE: keys are inlined into the client bundle at build time by Vite `define`
# (same behaviour as the previous GEMINI_API_KEY). For a production deployment,
# proxy these calls through a small backend instead of exposing the key.

# Your Arena.ai API key (sent as `Authorization: Bearer <key>`).
ARENA_API_KEY=

# Base URL of the Arena image API. Point this at the Arena endpoint you were
# issued, or at any OpenAI-compatible image gateway. No trailing slash.
ARENA_API_BASE_URL=https://api.arena.ai/v1

# Model ids exposed in the Frame Generator's model picker.
#   - image model:      quality tier (Generate / Refine / Variations)
#   - fast image model: image-to-image tier (Upscale / generative edits)
#   - text model:       prompt enhancement
ARENA_IMAGE_MODEL=arena-image-001
ARENA_IMAGE_MODEL_FAST=arena-image-fast-001
ARENA_TEXT_MODEL=arena-text-flash

# ── Legacy Google Gemini key ───────────────────────────────────────────────
# Still used by the *text* generation features outside the image engine
# (Characters AI synthesis, Lore Keeper, Storyflow, Style Alchemist,
# Soundtrack Composer, Panel Assembler, MainWorkspace insights).
# Safe to leave empty if you don't use those AI helpers.
GEMINI_API_KEY=
